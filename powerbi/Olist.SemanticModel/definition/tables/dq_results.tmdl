table dq_results
	lineageTag: 79485752-f902-5bac-b8d0-bf4a910f3468

	measure 'DQ score (mart)' = CALCULATE(1 - AVERAGE(dq_results[fail_share]), dq_results[layer] = "mart", dq_results[in_dq_score] = TRUE())
		formatString: 0.00%
		lineageTag: 239ce9e0-c03d-537f-b392-d7a67f7d14d9

	measure 'Mart checks pass' = CALCULATE(COUNTROWS(dq_results), dq_results[layer] = "mart", dq_results[status] = "pass") + 0
		formatString: 0
		lineageTag: 2849b188-7d60-57ef-924f-5e3eeb0ebeeb

	measure 'Mart checks warn' = CALCULATE(COUNTROWS(dq_results), dq_results[layer] = "mart", dq_results[status] = "warn") + 0
		formatString: 0
		lineageTag: 8784a275-fb07-5ea5-87da-23adc08b497e

	measure 'Mart checks fail' = CALCULATE(COUNTROWS(dq_results), dq_results[layer] = "mart", dq_results[status] = "fail") + 0
		formatString: 0
		lineageTag: b25c355e-2aa1-58d7-b09d-ed9f3a36ec35

	column check_id
		dataType: string
		lineageTag: f4cfc52c-9569-5b7a-bd82-5098763d2150
		summarizeBy: none
		sourceColumn: check_id

		annotation SummarizationSetBy = Automatic

	column layer
		dataType: string
