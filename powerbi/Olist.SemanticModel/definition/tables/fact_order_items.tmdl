	partition fact_order_items = m
		mode: import
		source =
				let
				    Source = Parquet.Document(File.Contents(ExportsFolder & "fact_order_items.parquet")),
				    Kept = Table.SelectColumns(Source, {"order_id", "order_item_id", "product_id", "seller_id", "price", "freight_value"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"order_id", type text}, {"order_item_id", Int64.Type}, {"product_id", type text}, {"seller_id", type text}, {"price", type number}, {"freight_value", type number}})
				in
				    Typed

	annotation PBI_ResultType = Table
