table fact_order_items
	lineageTag: 58a11196-bb8f-5946-aa0c-310fe38c4d5a

	measure 'GMV (mart)' = CALCULATE(SUM(fact_order_items[price]), fact_orders[in_window] = TRUE(), fact_orders[is_delivered] = TRUE())
		formatString: #,0
		lineageTag: f7313a43-ad3a-5da9-b406-3067060cb2bc

	measure 'GMV all statuses' = CALCULATE(SUM(fact_order_items[price]), fact_orders[in_window] = TRUE())
		formatString: #,0
		lineageTag: dd5a43c1-e01f-5dbc-b938-c78553723d4f

