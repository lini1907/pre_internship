	partition kpis_clean = m
		mode: import
		source =
				let
				    Source = Parquet.Document(File.Contents(ExportsFolder & "kpis_clean.parquet")),
				    Kept = Table.SelectColumns(Source, {"kpi_id", "item", "value", "rank"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"kpi_id", type text}, {"item", type text}, {"value", type number}, {"rank", Int64.Type}})
				in
				    Typed

	annotation PBI_ResultType = Table
