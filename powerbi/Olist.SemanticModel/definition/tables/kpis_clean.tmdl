	measure 'K7 Avg review score' = CALCULATE(SUM(kpis_clean[value]), kpis_clean[kpi_id] = "K7")
		formatString: 0.000
		lineageTag: fd7c90c5-113f-5ac2-ab96-de23d59dd28a

	measure 'K8 Negative review share' = CALCULATE(SUM(kpis_clean[value]), kpis_clean[kpi_id] = "K8")
		formatString: 0.0%
		lineageTag: 53b2401d-dd8a-5bb2-a6bc-b8bc1da1fd60

	measure 'K9 Repeat customer rate' = CALCULATE(SUM(kpis_clean[value]), kpis_clean[kpi_id] = "K9")
		formatString: 0.00%
		lineageTag: b15b8512-8c30-553d-8913-c7d162c894e8

	measure 'K10 Active customers' = CALCULATE(SUM(kpis_clean[value]), kpis_clean[kpi_id] = "K10")
		formatString: #,0
		lineageTag: 7e201303-ef79-52cf-be72-19ddb1c9b89a

	measure 'K15 Worst-rated category' = CALCULATE(MIN(kpis_clean[item]), kpis_clean[kpi_id] = "K15", kpis_clean[rank] = 1)
		lineageTag: dd300d26-9729-5960-987e-3d1beb8483c3

	column kpi_id
