table kpis_clean
	lineageTag: 6c0276de-2cc3-5b25-8e28-b36a8b7b2cab

	measure 'K1 GMV' = CALCULATE(SUM(kpis_clean[value]), kpis_clean[kpi_id] = "K1")
		formatString: #,0
		lineageTag: 2be14bf9-40f4-5353-8915-b61f4435240d

	measure 'K2 Delivered orders' = CALCULATE(SUM(kpis_clean[value]), kpis_clean[kpi_id] = "K2")
		formatString: #,0
		lineageTag: c1bc7c5e-43de-54a6-82c7-9034d69fc90b

	measure 'K3 AOV' = CALCULATE(SUM(kpis_clean[value]), kpis_clean[kpi_id] = "K3")
		formatString: #,0.00
		lineageTag: fc382287-e0a0-59ef-9511-e3517a317be2

	measure 'K4 Freight ratio' = CALCULATE(SUM(kpis_clean[value]), kpis_clean[kpi_id] = "K4")
