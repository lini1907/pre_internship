	partition fact_orders = m
		mode: import
		source =
				let
				    Source = Parquet.Document(File.Contents(ExportsFolder & "fact_orders.parquet")),
				    Kept = Table.SelectColumns(Source, {"order_id", "customer_unique_id", "status", "purchase_ts", "delivered_customer_ts", "estimated_delivery_date", "payment_total", "review_score", "is_delivered"}),
				    DateKey = Table.AddColumn(Kept, "purchase_date_key", each if [purchase_ts] = null then null else Number.From(DateTime.ToText([purchase_ts], "yyyyMMdd"))),
				    InWindow = Table.AddColumn(DateKey, "in_window", each [purchase_ts] <> null and [purchase_ts] >= #datetime(2017, 1, 1, 0, 0, 0) and [purchase_ts] < #datetime(2018, 9, 1, 0, 0, 0)),
				    OnTime = Table.AddColumn(InWindow, "on_time", each if [delivered_customer_ts] = null then null else if Date.From([delivered_customer_ts]) <= Date.From([estimated_delivery_date]) then 1 else 0),
				    Days = Table.AddColumn(OnTime, "delivery_days", each if [delivered_customer_ts] = null then null else Duration.TotalDays([delivered_customer_ts] - [purchase_ts])),
				    Typed = Table.TransformColumnTypes(Days, {{"order_id", type text}, {"customer_unique_id", type text}, {"status", type text}, {"purchase_ts", type datetime}, {"delivered_customer_ts", type datetime}, {"estimated_delivery_date", type datetime}, {"payment_total", type number}, {"review_score", Int64.Type}, {"is_delivered", type logical}, {"purchase_date_key", Int64.Type}, {"in_window", type logical}, {"on_time", Int64.Type}, {"delivery_days", type number}})
				in
				    Typed

	annotation PBI_ResultType = Table
