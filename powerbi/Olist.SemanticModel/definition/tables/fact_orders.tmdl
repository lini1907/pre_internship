table fact_orders
	lineageTag: 618ef731-cf6b-53f9-8b44-4d0d516fc176

	measure 'On-time rate' = CALCULATE(AVERAGE(fact_orders[on_time]), fact_orders[in_window] = TRUE(), fact_orders[is_delivered] = TRUE())
		formatString: 0.0%
		lineageTag: 8778490d-c56c-576e-936e-a3719ba101ff

	measure 'Mean delivery days' = CALCULATE(AVERAGE(fact_orders[delivery_days]), fact_orders[in_window] = TRUE(), fact_orders[is_delivered] = TRUE())
		formatString: 0.0
		lineageTag: 0e295fdd-1e89-5a5c-91ab-b80d30960761

	measure 'Avg review score' = CALCULATE(AVERAGE(fact_orders[review_score]), fact_orders[in_window] = TRUE())
		formatString: 0.00
		lineageTag: c08a5c81-31fb-524a-b0d1-01e7541c6620

	measure 'Reviewed orders' = CALCULATE(COUNTROWS(fact_orders), fact_orders[in_window] = TRUE(), KEEPFILTERS(NOT ISBLANK(fact_orders[review_score])))
		formatString: #,0
		lineageTag: a3931df9-2700-59df-be8c-791e351bb432

	measure 'Delivered orders (mart)' = CALCULATE(COUNTROWS(fact_orders), fact_orders[in_window] = TRUE(), fact_orders[is_delivered] = TRUE())
		formatString: #,0
		lineageTag: 638f8f97-61c0-547f-97af-e988f8400c40

